# Azure AI Foundry (needed from phase 3 onward; phases 1-2 run without it)
RACE_BOT_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
RACE_BOT_AZURE_API_KEY=
RACE_BOT_AZURE_API_VERSION=2024-10-21

# Deployment names. The situation agent runs every tick, so keep it cheap;
# the tactics agent runs only on meaningful change, so it can be stronger.
RACE_BOT_SITUATION_MODEL=gpt-4o-mini
RACE_BOT_TACTICS_MODEL=gpt-4o
